Options +Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force canonical host: livecontainer.site -> www.livecontainer.site
  RewriteCond %{HTTP_HOST} ^livecontainer\.site$ [NC]
  RewriteRule ^(.*)$ https://www.livecontainer.site/$1 [L,R=301]

  # Prefer clean directory URLs when hosting at domain root
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>
